{
  "name": "chaoscanvas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.1"
  },
  "type": "module",
  "scripts": {
    "build:dev": "vite build --mode development --config config/vite.config.ts",
    "build:prod": "vite build --mode production --config config/vite.config.ts",
    "build": "npm run build:prod",
    "dev": "vite --mode development --port 8080 --host 127.0.0.1 --config config/vite.config.ts",
    "start:dev": "vite --mode development --port 8080 --host 127.0.0.1 --config config/vite.config.ts",
    "start:prod": "vite preview --port 8080 --host 127.0.0.1 --config config/vite.config.ts",
    "start:dev-simple": "vite --mode development --port 8080 --host 127.0.0.1",
    "start:prod-simple": "vite preview --port 8080 --host 127.0.0.1",
    "start": "npm run dev",
    "preview": "vite preview --config config/vite.config.ts",
    "serve": "vite preview --port 5000 --config config/vite.config.ts",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "npm run prettier && npm run eslint",
    "eslint": "eslint --fix --ext .js,.jsx,.ts,.tsx,.vue app config",
    "eslint:check": "eslint --ext .js,.jsx,.ts,.tsx,.vue app config",
    "lint:check": "npm run eslint:check",
    "prettier": "prettier --config .prettierrc.json --write \"{app,config}/**/*.{js,jsx,ts,tsx,vue,json,css,scss,less}\"",
    "prettier:check": "prettier --config .prettierrc.json --check \"{app,config}/**/*.{js,jsx,ts,tsx,vue,json,css,scss,less}\"",
    "clean": "rimraf dist",
    "clean:deps": "rimraf node_modules package-lock.json",
    "prebuild": "npm run clean",
    "prebuild:prod": "npm run clean",
    "analyze": "cross-env ANALYZE=true vite build --mode production --config config/vite.config.ts",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.3",
    "happy-dom": "^20.14.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.69.0",
    "terser": "^5.26.0",
    "typescript": "~5.7.2",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "prettier --write"
    ],
    "*.{json,css,scss,less,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check"
    }
  }
}
