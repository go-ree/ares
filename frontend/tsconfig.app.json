{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app/web/*"
      ],
      "@shared/*": [
        "./app/shared/*"
      ],
      "@components/*": [
        "./app/web/components/*"
      ],
      "@assets/*": [
        "./app/web/assets/*"
      ],
      "@services/*": [
        "./app/shared/services/*"
      ],
      "@utils/*": [
        "./app/shared/utils/*"
      ]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "app/**/*.ts",
    "app/**/*.vue"
  ],
  "exclude": [
    "app/web-react",
    "dist-react",
    "node_modules"
  ]
}
