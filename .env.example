# Public entry point and local-only backend diagnostics.
ARES_HTTP_PORT=8080
ARES_API_PORT=8081
ARES_BIND_ADDRESS=127.0.0.1
TZ=Asia/Shanghai

# Change these values before using the stack outside local evaluation.
MYSQL_DATABASE=ares
MYSQL_USER=ares
MYSQL_PASSWORD=ares-demo-password
MYSQL_ROOT_PASSWORD=ares-root-password

# Demo records are inserted only when the apps table is empty.
ARES_DEMO_DATA_ENABLED=true

# External integrations are optional for the standalone stack.
ARES_JENKINS_ENABLED=false
ARES_JENKINS_ADDRESS=
ARES_JENKINS_USERNAME=
ARES_JENKINS_TOKEN=
ARES_JENKINS_TIMEOUT_SECONDS=15
ARES_K8S_ENABLED=false
ARES_K8S_TIMEOUT_SECONDS=15

# Optional Go module proxy used while building the backend image.
GOPROXY=https://proxy.golang.org,direct
