# Public entry point and local-only backend diagnostics.
ARES_HTTP_PORT=8080
ARES_API_PORT=8081
ARES_BIND_ADDRESS=127.0.0.1
TZ=Asia/Shanghai

# Change these values before using the stack outside local evaluation.
# Compose .env values containing `$` should use single quotes so they remain
# literal. The database initialization script safely handles SQL punctuation.
MYSQL_DATABASE=ares
MYSQL_ROOT_PASSWORD=ares-root-password
MYSQL_RUNTIME_USER=ares_runtime
MYSQL_RUNTIME_PASSWORD=ares-runtime-demo-password
MYSQL_MIGRATION_USER=ares_migrator
MYSQL_MIGRATION_PASSWORD=ares-migrator-demo-password

# 大库升级时可按 schema 检查/迁移耗时调高；锁超时只控制等待 migrator。
ARES_DB_SCHEMA_MIGRATION_TIMEOUT=2m
ARES_DB_MIGRATION_LOCK_TIMEOUT=30s
# 账号安全收敛任务的单次连接与整体时限（正整数秒）。
ARES_DATABASE_ACCOUNT_CONNECT_TIMEOUT_SECONDS=5
ARES_DATABASE_ACCOUNT_LOCK_TIMEOUT_SECONDS=30
ARES_DATABASE_ACCOUNT_INIT_TIMEOUT_SECONDS=60

# Demo records are inserted only when all related business tables are empty.
ARES_DEMO_DATA_ENABLED=true

# Used only to protect and encrypt settings entered through the Web console.
# Replace both values before using the stack outside local evaluation.
ARES_SETTINGS_ADMIN_TOKEN=ares-local-admin-token
ARES_SETTINGS_ENCRYPTION_KEY=ares-local-encryption-key-change-me-32chars

# Optional Go module proxy used while building the backend image.
GOPROXY=https://proxy.golang.org,direct
