# Public entry point and local-only backend diagnostics. Compose derives the
# exact browser origin as http://localhost:${ARES_HTTP_PORT}; keep the browser
# on that origin so the session and CSRF checks match.
ARES_HTTP_PORT=8080
ARES_API_PORT=8081
ARES_COMPOSE_SUBNET=172.30.238.0/24
ARES_COMPOSE_WEB_IP=172.30.238.10
ARES_BIND_ADDRESS=127.0.0.1
TZ=Asia/Shanghai

# Change these values before using the stack outside local evaluation.
# Compose .env values containing `$` should use single quotes so they remain
# literal. The database initialization script safely handles SQL punctuation.
MYSQL_DATABASE=ares
MYSQL_ROOT_PASSWORD=ares-root-password
MYSQL_RUNTIME_USER=ares_runtime
MYSQL_RUNTIME_PASSWORD=ares-runtime-demo-password
MYSQL_MIGRATION_USER=ares_migrator
MYSQL_MIGRATION_PASSWORD=ares-migrator-demo-password

# 大库升级时可按 schema 检查/迁移耗时调高；锁超时只控制等待 migrator。
ARES_DB_SCHEMA_MIGRATION_TIMEOUT=2m
ARES_DB_MIGRATION_LOCK_TIMEOUT=30s
# 账号安全收敛任务的单次连接与整体时限（正整数秒）。
ARES_DATABASE_ACCOUNT_CONNECT_TIMEOUT_SECONDS=5
ARES_DATABASE_ACCOUNT_LOCK_TIMEOUT_SECONDS=30
ARES_DATABASE_ACCOUNT_INIT_TIMEOUT_SECONDS=60

# Demo records are inserted only when all related business tables are empty.
ARES_DEMO_DATA_ENABLED=true

# Compose generates the browser-session root key, one-time bootstrap token,
# and settings encryption key into the private persistent `auth_secrets`
# volume. No fixed authentication credential is committed here. `down` keeps
# the volume; `down -v` deletes it and causes new secrets to be generated.
# Local login/bootstrap are enabled and OIDC is disabled by compose.yaml. Use
# a reviewed production override to mount OIDC secrets; extra values added to
# this .env file are not automatically passed into the container. The legacy
# shared admin-token compatibility path remains disabled.
ARES_AUTH_LEGACY_ADMIN_TOKEN_ENABLED=false

# Optional Go module proxy used while building the backend image.
GOPROXY=https://proxy.golang.org,direct
